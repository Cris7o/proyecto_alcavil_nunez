<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.pedidos360</groupId>
	<artifactId>streaming-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>streaming-service</name>
	<description>Aplicaciones consumidoras de Kinesis Data Streams (KCL) de Pedido360, agrupadas por dominio</description>

	<properties>
		<java.version>17</java.version>
		<!--
			Kinesis Client Library 3.x: procesador por shard, checkpoint y tabla
			de coordinacion (leases) en DynamoDB. Trae su propia version del
			AWS SDK v2, que es la que se usa en todo este servicio.
		-->
		<kcl.version>3.5.4</kcl.version>
		<!-- La version del AWS SDK v2 con la que se publica la KCL 3.5.4 -->
		<awssdk.version>2.41.21</awssdk.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${awssdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>software.amazon.kinesis</groupId>
			<artifactId>amazon-kinesis-client</artifactId>
			<version>${kcl.version}</version>
		</dependency>
		<!-- Clientes sincronicos: estado derivado y publicacion al stream de fallidos -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>apache-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
